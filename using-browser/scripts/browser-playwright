#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/browser-common
source "$SCRIPT_DIR/browser-common"

usage() {
  cat <<'USAGE'
Usage:
  browser-playwright status
  browser-playwright attach
  browser-playwright detach
  browser-playwright <playwright-args...>

Environment:
  BROWSER_PLAYWRIGHT_SESSION   Session name; defaults to shared-browser
  BROWSER_PLAYWRIGHT_PACKAGE   Optional exact npm package spec
  BROWSER_PLAYWRIGHT_COMMAND   CLI command; defaults to playwright-cli
  BROWSER_PLAYWRIGHT_RUNNER    Optional executable used by tests or local adapters
USAGE
}

is_exact_package_spec() {
  local spec="$1"
  [[ "$spec" =~ ^@[^/]+/[^@]+@[^@]+$ || "$spec" =~ ^[^@/]+@[^@]+$ ]]
}

session_name() {
  printf '%s\n' "${BROWSER_PLAYWRIGHT_SESSION:-shared-browser}"
}

write_session() {
  local endpoint="$1"
  local name="$2"
  printf '{"attached":true,"session":"%s","endpoint":"%s","attachedAt":"%s"}\n' \
    "$(browser_runtime_json_escape "$name")" \
    "$(browser_runtime_json_escape "$endpoint")" \
    "$(browser_runtime_now_iso)" \
    >"$(browser_runtime_playwright_session_file)"
}

validate_playwright_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --cdp|--cdp=*|--cdp-endpoint|--cdp-endpoint=*|--endpoint|--endpoint=*|--session|--session=*|-s|-s=*|--browser|--browser=*|--browser-channel|--browser-channel=*|--user-data-dir|--user-data-dir=*|--port|--port=*)
        echo "browser-playwright owns session and CDP connection flags" >&2
        return 2
        ;;
    esac
  done

  case "${1:-}" in
    open|close|close-all|kill-all|quit|kill|shutdown|stop|restart|launch)
      echo "browser-playwright cannot run shared browser lifecycle command: ${1:-}" >&2
      return 2
      ;;
  esac
}

do_status() {
  local file
  file="$(browser_runtime_playwright_session_file)"
  if [[ -f "$file" ]]; then
    cat "$file"
  else
    printf '{"attached":false,"session":"%s"}\n' "$(browser_runtime_json_escape "$(session_name)")"
  fi
}

resolve_cli() {
  # Prints the argv prefix that invokes the upstream playwright CLI.
  local runner package cli_command
  runner="${BROWSER_PLAYWRIGHT_RUNNER:-}"
  package="${BROWSER_PLAYWRIGHT_PACKAGE:-}"
  cli_command="${BROWSER_PLAYWRIGHT_COMMAND:-playwright-cli}"

  if [[ -n "$runner" ]]; then
    printf '%s\n' "$runner"
    return 0
  fi

  if [[ -n "$package" ]]; then
    if ! is_exact_package_spec "$package"; then
      echo "BROWSER_PLAYWRIGHT_PACKAGE must pin an exact version: $package" >&2
      return 2
    fi
    printf 'npm exec --yes --package %s -- %s\n' "$package" "$cli_command"
    return 0
  fi

  if ! command -v "$cli_command" >/dev/null 2>&1; then
    echo "playwright CLI '$cli_command' not found; install @playwright/cli (npm i -g @playwright/cli) or set BROWSER_PLAYWRIGHT_PACKAGE/BROWSER_PLAYWRIGHT_COMMAND" >&2
    return 127
  fi

  printf '%s\n' "$cli_command"
}

invoke_cli_with_auto_attach() {
  # Usage: invoke_cli_with_auto_attach <endpoint> <session> <cli-prefix...> -- <args...>
  # @playwright/cli routes actions through a named daemon session; when that
  # session is not open yet, attach it to the shared endpoint and retry once.
  # The "is not open" failure is reported on stdout, so stdout is captured
  # while stderr streams through.
  local endpoint="$1" name="$2"
  shift 2
  local cli=() args=()
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    cli+=("$1")
    shift
  done
  [[ "${1:-}" == "--" ]] && shift
  args=("$@")

  local out_file rc
  out_file="$(mktemp)"

  if "${cli[@]}" "${args[@]}" --session "$name" >"$out_file"; then
    cat "$out_file"
    rm -f "$out_file"
    return 0
  fi
  rc=$?

  if grep -q "is not open" "$out_file" 2>/dev/null && \
     "${cli[@]}" attach --cdp "$endpoint" --session "$name" >&2; then
    if "${cli[@]}" "${args[@]}" --session "$name" >"$out_file"; then
      rc=0
    else
      rc=$?
    fi
  fi

  cat "$out_file"
  rm -f "$out_file"
  return "$rc"
}

do_attach() {
  local endpoint name cli
  endpoint="$(BROWSER_RUNTIME_LOCK_BYPASS=true "$SCRIPT_DIR/browser-runtime" endpoint)" || return
  name="$(session_name)"
  cli="$(resolve_cli)" || return $?

  $cli attach --cdp "$endpoint" --session "$name" || return $?
  write_session "$endpoint" "$name"
  cat "$(browser_runtime_playwright_session_file)"
}

do_detach() {
  local name cli
  name="$(session_name)"
  if cli="$(resolve_cli)" 2>/dev/null; then
    $cli detach --session "$name" >/dev/null 2>&1 || true
  fi
  rm -f "$(browser_runtime_playwright_session_file)"
  echo "detached"
}

run_playwright() {
  local command="${1:-}"
  case "$command" in
    status) do_status; return ;;
    attach) do_attach; return ;;
    detach) do_detach; return ;;
    -h|--help|help|"") usage; return ;;
  esac

  validate_playwright_args "$@"

  local endpoint name runner package cli_command
  runner="${BROWSER_PLAYWRIGHT_RUNNER:-}"
  package="${BROWSER_PLAYWRIGHT_PACKAGE:-}"
  cli_command="${BROWSER_PLAYWRIGHT_COMMAND:-playwright-cli}"

  # The snapshot/click/fill verb set belongs to @playwright/cli, so fail fast
  # with the fix when its CLI is missing, before touching session state.
  if [[ -z "$runner" && -z "$package" ]] && ! command -v "$cli_command" >/dev/null 2>&1; then
    echo "playwright CLI '$cli_command' not found; install @playwright/cli (npm i -g @playwright/cli) or set BROWSER_PLAYWRIGHT_PACKAGE/BROWSER_PLAYWRIGHT_COMMAND" >&2
    return 127
  fi

  endpoint="$(BROWSER_RUNTIME_LOCK_BYPASS=true "$SCRIPT_DIR/browser-runtime" endpoint)"
  name="$(session_name)"

  write_session "$endpoint" "$name"
  export BROWSER_PLAYWRIGHT_CDP_ENDPOINT="$endpoint"
  export PLAYWRIGHT_CDP_ENDPOINT="$endpoint"
  export BROWSER_PLAYWRIGHT_SESSION_NAME="$name"

  if [[ -n "$runner" ]]; then
    "$runner" "$@" --session "$name"
    return $?
  fi

  local cli
  cli="$(resolve_cli)" || return $?

  invoke_cli_with_auto_attach "$endpoint" "$name" $cli -- "$@"
}

browser_runtime_with_lock run_playwright "$@"
